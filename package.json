{
  "name": "xananas-garden-mvp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "ts-node prisma/seed.ts",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:reset": "npx prisma migrate reset --force && npm run seed",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate",
    "db:migrate-turso": "npx ts-node scripts/apply-turso-migration.ts",
    "postinstall": "npx prisma generate",
    "start:prod": "npx prisma generate && npx next start"
  },
  "vercel": {
    "buildCommand": "npm run vercel-build"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/client": "^6.9.0",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.4.2",
    "formidable": "^3.5.2",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "next": "^14.2.22",
    "nookies": "^2.5.2",
    "nprogress": "^0.2.0",
    "pdfmake": "^0.3.11",
    "phosphor-react": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.33.5",
    "swr": "^2.5.1",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie": "^1.0.0",
    "@types/formidable": "^3.4.5",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/jwt-decode": "^2.2.1",
    "@types/node": "^20.17.12",
    "@types/nookies": "^1.1.0",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.22",
    "postcss": "^8.4.49",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
