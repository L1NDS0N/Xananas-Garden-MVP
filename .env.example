[TEMPLATE]
# ==========================================
# Xananas' Garden - Environment Variables
# ==========================================

# Local development (SQLite)
DATABASE_URL="file:./dev.db"

# Authentication (gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=""

# ==========================================
# Google OAuth2 (Login via Google)
# ==========================================
# Crie um projeto em https://console.cloud.google.com/apis/credentials
# 1. Crie OAuth 2.0 Client ID (Web application)
# 2. Adicione URI de redirecionamento autorizado:
#    - http://localhost:3000/api/v1/auth/google/callback
#    - https://SEU-DOMINIO.vercel.app/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# ==========================================
# PRODUCTION (Turso Database - Vercel)
# ==========================================
# TURSO_DATABASE_URL="libsql://NOME-DO-BANCO-ORG.turso.io"
# TURSO_AUTH_TOKEN=""
# JWT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="https://SEU-DOMINIO.vercel.app/api/v1/auth/google/callback"
